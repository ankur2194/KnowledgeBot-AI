# services/ai-service — container environment.
#
# Every variable below maps to a field on app/core/config.py's `Settings`. That is a property
# of THIS FILE being kept in sync, and it is NOT enforced at runtime — the header used to claim
# it was, and the claim was wrong in the dangerous direction.
#
# `Settings` does set extra="forbid", but read config.py:5-16 before trusting it: verified
# against pydantic-settings 2.13.0, `forbid` rejects extras passed to `Settings(...)` and extras
# found in a DOTENV file — it CANNOT reject environment variables, because nothing enumerates
# the environment looking for the prefix. So a typo'd `KB_` variable is silently ignored and the
# field silently takes its default. That is exactly the failure mode the old header promised
# could not happen.
#
# The practical split: copy this to `.env` for a local run and forbid does apply, because it is
# then a dotenv file. In Compose these arrive via `env_file:
# infrastructure/docker/env/ai-service.env`, which makes them ENVIRONMENT variables — and there
# forbid protects nothing. Check by hand:
#   python -c "from app.core.config import Settings; import os; \
#     k={'KB_'+n.upper() for n in Settings.model_fields}; \
#     print(sorted({v for v in os.environ if v.startswith('KB_')} - k))"
# An empty list is the only passing result. (It is not empty in the Compose stack today; see the
# container template's own header.)

KB_ENVIRONMENT=local

# ── datastores ───────────────────────────────────────────────────────────────
KB_POSTGRES_DSN=postgresql://kb:kb@postgres:5432/kb
KB_POSTGRES_POOL_MIN=2
KB_POSTGRES_POOL_MAX=10

KB_QDRANT_URL=http://qdrant:6333
# No KB_QDRANT_COLLECTION, deliberately. The collection name is a module constant in
# app/retrieval/collection.py — an env-overridable name can disagree between the indexer
# and the reader, and that disagreement reads as an empty corpus rather than an error.

# redis://, never valkey:// — kombu has no valkey transport alias and the scheme raises
# "No such transport" at first connect, long after startup, looking like a broker outage.
# Two servers, not two logical databases: the broker must run noeviction (kombu raises
# InconsistencyError if a _kombu.binding.* key is evicted) while the cache runs allkeys-lru,
# and both are server-level settings.
KB_BROKER_URL=redis://valkey-core:6379/0
KB_CACHE_URL=redis://valkey-cache:6379/0

KB_S3_ENDPOINT=http://seaweedfs-s3:8333
KB_S3_BUCKET=kb-objects

# ── internal transport ───────────────────────────────────────────────────────
# The HMAC keys themselves are NOT here and never will be. They are mounted files, read
# from this directory by path — `docker compose config` renders interpolated values in
# full, and an environment variable is visible to every `docker inspect`.
KB_HMAC_KEY_DIR=/run/secrets
KB_HMAC_ACTIVE_KEY_ID=k1
KB_HMAC_MAX_SKEW_SECONDS=60

# ── models ───────────────────────────────────────────────────────────────────
# PARSING AND OCR ONLY. models.manifest.toml pins docling's layout model, TableFormer and
# RapidOCR's ONNX weights by commit sha — a revision in two places drifts, so it is not
# repeated here.
#
# It is NOT where embedding identity lives, and the old comment here said the opposite.
# ADR-030 made embedding a provider API call, so there is no local revision to fold in.
# Identity is `EmbeddingModelIdentity` — the provider's model space plus a canary digest —
# because a provider model NAME is an alias the vendor may re-point with no version bump.
# models.manifest.toml's own header says this in full; read it before re-adding a revision
# here.
KB_MODEL_CACHE_DIR=/models
# NO KB_EMBEDDING_DEVICE. `Settings` has no `embedding_device` field (config.py:129: "there is
# no `embedding_device` any more — nothing embeds locally, so there is no device to pick").
# It sat here reading `cpu` long after the thing it placed was deleted, and per the header
# above an unknown KB_* env var does NOT fail startup, so nothing was ever going to say so.
# The sibling container template (infrastructure/docker/env/ai-service.env.example) already
# dropped it; this file was missed.
#
# A request-shaping number now, not a GPU-memory one: it trades requests-per-minute against
# per-request latency and against how much work one failed call loses.
KB_EMBEDDING_BATCH_SIZE=8

# ── timeout budgets ──────────────────────────────────────────────────────────
# 8 + 45 = 53 < 55. Raising one without lowering another bills tokens for a completion the
# caller already abandoned.
KB_INTERNAL_CALL_TIMEOUT=55
KB_RETRIEVAL_TIMEOUT=8
KB_PROVIDER_TOTAL_TIMEOUT=45
KB_PROVIDER_FIRST_TOKEN_TIMEOUT=20
KB_PROVIDER_CONNECT_TIMEOUT=3

# ── telemetry ────────────────────────────────────────────────────────────────
KB_OTEL_SERVICE_NAME=ai-api
KB_LOG_LEVEL=INFO

OTEL_SERVICE_NAME=ai-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_METRICS_EXEMPLAR_FILTER=trace_based
OTEL_LOGS_EXPORTER=none

# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT is deliberately absent — not set,
# not commented out with a value. It would put tenant prompts and answers into spans, and
# the service asserts at boot that it is unset and refuses to start if it is not.

# ── uvicorn ──────────────────────────────────────────────────────────────────
# Read by uvicorn, not by `Settings` — hence no KB_ prefix. It silently sets --workers even
# with no flag passed.
#
# The value is 1 and the REASON IS NOT MEMORY ANY MORE. The old text here ("a 2 GB embedder
# plus a 1.5 GB reranker at 4 workers is 14 GB resident") describes models ADR-030 removed;
# ai-api loads none. It stays at 1 for a weaker but still-real reason: each worker runs its
# own lifespan, so N workers open N Qdrant and N psycopg pools against KB_POSTGRES_POOL_MAX
# and the Qdrant client limits above, which are sized for one. Raising it is a legitimate
# question that must be answered together with those pool sizes, never alone.
# infrastructure/docker/compose.yaml's ai-api block is where that reasoning lives.
WEB_CONCURRENCY=1
