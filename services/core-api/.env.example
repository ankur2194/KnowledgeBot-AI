# =============================================================================
# KnowledgeBot AI — control plane (services/core-api)
#
# Copy to .env and fill in. Every value below has a comment when the default is
# not obvious or when getting it wrong fails SILENTLY.
#
# ONE VARIABLE MUST NEVER APPEAR IN THIS FILE, IN .env, OR IN ANY COMPOSE FILE —
# not set, not empty, not commented out with a value:
#
#     OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT
#
# It gates gen_ai.input.messages, gen_ai.output.messages, gen_ai.system_instructions,
# gen_ai.retrieval.query.text and gen_ai.retrieval.documents — the user's question and
# the retrieved tenant chunks. Setting it ships customer documents into Tempo, which has
# no per-tenant access control and a fixed retention. There is no permitted value — not
# `false`, not empty — because the name being present at all means somebody reached for
# the switch, and the next person to edit the file will read it as a supported option.
#
# WHAT ENFORCES THAT, AND WHERE IT DOES NOT. The fail-closed boot check is real, but it
# lives in the DATA PLANE only: services/ai-service/app/observability/otel.py raises when
# the name is present in the process environment (presence, not truthiness). THIS SERVICE
# HAS NO SUCH CHECK — nothing under app/, bootstrap/ or config/ reads the name, so a
# control plane container started with it set boots normally and nothing reports it. The
# Laravel-side boot check is still to be written; until it is, this comment is the only
# thing standing between the variable and a Compose file.
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS ARE FILES IN EVERY DEPLOYED ENVIRONMENT.
#
# Every variable below marked "secret" is resolved through App\Support\Kb\KbSecrets, which
# checks <NAME>_FILE, then <NAME>_PATH, then <NAME>, then the default. THE FILE WINS OVER
# THE INLINE VALUE, and an unreadable, missing or EMPTY file THROWS — it never degrades to
# the inline value and never degrades to null. (An empty HMAC key is not a broken key:
# hash_hmac with '' returns a valid digest that matches any peer which also resolved to
# empty. Authentication switches off and nothing raises.)
#
# In local development you fill the inline values here and mount nothing; that is the norm
# and it is supported. In Compose the values stay EMPTY and the pointers are set in
# infrastructure/docker/env/core-api.env:
#
#   APP_KEY_FILE=/run/secrets/app_key
#   APP_PREVIOUS_KEYS_FILE=/run/secrets/app_previous_keys
#   KB_KEK_PATH=/run/secrets/kek                                  (KB_KEK_FILE also accepted)
#   AI_HMAC_KEY_K1_FILE=/run/secrets/hmac_key_k1
#   AI_HMAC_KEY_K2_FILE=/run/secrets/hmac_key_k2
#   AI_CALLBACK_HMAC_KEY_C1_FILE=/run/secrets/callback_hmac_key_c1
#   AI_CALLBACK_HMAC_KEY_C2_FILE=/run/secrets/callback_hmac_key_c2
#   DB_PASSWORD_FILE=/run/secrets/postgres_password
#   AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_key
#
# Secret FILES are named by KEY ID, never by rotation role: the wire carries the id
# (X-KB-Signature = key_id + ":" + hex(...)), verifiers accept two ids at once during a
# rotation, and the id is what stays stable across it. A file called `current` cannot answer
# "which id is this", and after a rotation the same physical key would have to be renamed.
#
# A secret VALUE in a Compose env file is the finding this exists to close: `make prod-config`
# runs `docker compose config`, which renders every interpolated value IN FULL into the
# terminal, the CI log, and whatever ticket that output is pasted into.
# -----------------------------------------------------------------------------

APP_NAME=KnowledgeBot
APP_ENV=local
# secret — APP_KEY_FILE=/run/secrets/app_key in Compose.
#
# It is one of the secrets above and not an exception to them: it encrypts sessions and cookies,
# it is the key behind every `encrypted:` cast (which is where provider credentials live), and it
# is the HMAC key behind the audit `key_fingerprint`. As an env VALUE it renders in full in a
# `docker compose config` dump, which `make prod-config` runs before every deploy.
#
# LOCALLY: leave the pointer unset, run `php artisan key:generate`, and it writes the value on the
# line below — unchanged from how it has always worked. In Compose the pointer is set, the file
# wins, and `key:generate` would be inert; rotate by replacing the secret and restarting.
#
# Rotating it invalidates sessions and cookies, not provider credentials — those are
# envelope-encrypted with their own data keys (KB_KEK).
APP_KEY=
# secret — APP_PREVIOUS_KEYS_FILE=/run/secrets/app_previous_keys in Compose.
#
# A COMMA-SEPARATED list of retired APP_KEY values, kept readable for exactly the rotation window
# in which the current key sits beside it — the same material, on the same terms. It lets sessions
# and cookies encrypted under the old key keep decrypting, so a rotation does not log every admin
# out mid-deploy. Empty is the normal state; a value here means a rotation is in flight, and
# removing it is the DELIBERATE SECOND STEP that finishes one.
#
# A file may hold `k1,k2` on one line or one key per line; both parse to the same list, and a
# trailing newline or trailing comma adds no empty key.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

# HARD REQUIREMENT. The schedule runs interval frequencies with no wall clock to skip or
# repeat, and every tenant-local time is stored as a UTC timestamptz. config/app.php pins
# 'UTC' literally and reads no env var; this line exists so nothing else in the stack
# assumes otherwise. There is deliberately no APP_SCHEDULE_TIMEZONE.
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=stdout
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# PostgreSQL — the source of truth. Never SQLite, in any environment including tests.
# -----------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=knowledgebot
DB_USERNAME=knowledgebot
# secret — DB_PASSWORD_FILE=/run/secrets/postgres_password in Compose.
DB_PASSWORD=
DB_SSLMODE=prefer

# -----------------------------------------------------------------------------
# Valkey — TWO instances, and the split is not optional.
#
#   valkey-core   maxmemory-policy noeviction, AOF everysec.
#                 Holds queues, the DEFAULT cache store, sessions, locks, fences,
#                 idempotency records, replay nonces, breakers and rate limiters —
#                 everything that fails OPEN when its key disappears.
#   valkey-cache  allkeys-lru, no RDB, no AOF. Holds answer/retrieval/config/quota
#                 caches, i.e. tenant text, which is why it never touches disk.
#
# maxmemory-policy is a SERVER setting shared by every logical DB, so this cannot be
# solved with a database index. Pointing CACHE_STORE at the evicting instance makes an
# evicted lock key read as "lock is free" and an evicted queue list read as "empty
# queue" — no exception in either direction.
# -----------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=valkey-core
REDIS_PORT=6379
REDIS_USERNAME=
# secret — REDIS_PASSWORD_FILE=/run/secrets/<name> when the instance is password-protected.
REDIS_PASSWORD=
# Per-connection logical DB on valkey-core.
REDIS_DB=0               # Laravel queues + the default cache store
REDIS_COORDINATION_DB=2  # locks, fences, idempotency, nonces, breakers, limiters
REDIS_HORIZON_DB=3       # Horizon's own keyspace
# Empty on purpose: queues:*, horizon:* and idem:* must appear LITERALLY, because the
# keyspace is shared with the FastAPI side. Environment separation is the logical DB plus
# a Valkey 9.1 database-level ACL user, never a client-side prefix.
REDIS_PREFIX=

REDIS_CACHE_HOST=valkey-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=0
REDIS_CACHE_USERNAME=
# secret — REDIS_CACHE_PASSWORD_FILE=/run/secrets/<name> when the instance is password-protected.
REDIS_CACHE_PASSWORD=

# `valkey` = the noeviction instance. Never `ephemeral`, never `array`, never `file`:
# WithoutOverlapping and the scheduler's onOneServer mutex resolve through the DEFAULT
# store and cannot be pointed anywhere else, and both FileStore and ArrayStore implement
# LockProvider — so every replica wins its own lock and every replica runs the task.
CACHE_STORE=valkey
CACHE_PREFIX=

QUEUE_CONNECTION=valkey

# -----------------------------------------------------------------------------
# Session — admin SPA only. The public runtime, the SDK and the internal surface carry
# no session at all.
# -----------------------------------------------------------------------------
SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_STORE=valkey
SESSION_LIFETIME=120
SESSION_COOKIE=kb_session
SESSION_SECURE_COOKIE=true
# ADMIN AND API HOSTS ONLY — never '.example.com'. A leading-dot parent domain sends this
# cookie to EVERY subdomain, so a widget served as a sibling host would carry a live admin
# credential inside an iframe on a hostile customer page, and any subdomain takeover
# becomes a CSRF platform. Leave EMPTY for a host-only cookie unless you know you need
# one specific extra host.
SESSION_DOMAIN=

# EXACT HOSTS, WITH PORTS, comma-separated. NEVER a wildcard and never '*':
# fromFrontend() strips the scheme and Str::is-matches the host only, so '*.example.com'
# matches a dangling DNS record and matches over plain http://. An empty value fails
# closed (no request is treated as first-party), which is loud; a value containing
# localhost is what ships to production by accident.
SANCTUM_STATEFUL_DOMAINS=app.localhost:3000,api.localhost
SANCTUM_TOKEN_PREFIX=kb_

# Comma-separated exact origins WITH scheme and port. Never '*' — the browser rejects a
# wildcard outright when credentials are allowed, and a wildcard on the SDK surface lets
# any page on the internet mint widget sessions.
CORS_ALLOWED_ORIGINS=http://app.localhost:3000

# -----------------------------------------------------------------------------
# Mail. Real SMTP in every environment; Mailpit is the local relay
# (infrastructure/docker/compose.yaml:1681). config/mail.php defines exactly two
# mailers: `smtp` and `array`. There is deliberately NO `log` mailer — MAIL_MAILER=log
# writes the full password-reset URL, a live credential, into storage/logs.
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
# secret — MAIL_PASSWORD_FILE=/run/secrets/<name> when the relay authenticates.
# Mailpit needs none; a real relay does, and it resolves through KbSecrets.
MAIL_PASSWORD=
# Empty for Mailpit (plain SMTP on 1025). `smtps` or `smtp` for a real relay; leaving
# it unset lets Symfony derive it from the port, which is the local-dev behaviour.
MAIL_SCHEME=
# The envelope/From identity. MAIL_FROM_ADDRESS on a domain whose SPF/DKIM you control,
# or every reset mail lands in spam and the failure looks like "the link never arrived".
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME=KnowledgeBot
# The EHLO name. Unset, Symfony sends the container's hostname, which a strict relay rejects.
MAIL_EHLO_DOMAIN=

# -----------------------------------------------------------------------------
# The Next.js admin console's PUBLIC base URL. Every emailed link — password reset,
# email verification, organization invitation — is built from this and points at the
# SPA, never at a Laravel route: there are no Blade pages here at all.
#
# NOT APP_URL. APP_URL is this API's own host (api.<domain>); this is app.<domain>.
# Getting them confused sends every recipient to a JSON 404.
#
# It must appear WITHOUT a trailing slash (config/kb.php rtrims it anyway) and it must
# be non-empty: App\Support\Kb\FrontendUrl throws rather than emitting `https:///verify`,
# because an email that goes out and does nothing is the failure nobody notices.
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000

# Token lifetimes, hours. Password reset's is config/auth.php's `expire` (60 MINUTES)
# and is deliberately not an env var — AUTH_PASSWORD_RESET_EXPIRE would contain
# "PASSWORD" and would need allow-listing in tests/Arch/SecretsResolverTest.php for a
# value that is not a secret.
KB_INVITATION_TTL_HOURS=168
KB_EMAIL_VERIFICATION_TTL_HOURS=24

# -----------------------------------------------------------------------------
# The Laravel -> FastAPI seam. Signed HMAC-SHA256, canonical prefix KB1.
# -----------------------------------------------------------------------------
AI_SERVICE_URL=http://ai-api:8000
# The id THIS service signs with. The verifier accepts every id below, which is what makes
# a rotation possible: signer and verifier deploy at different times, so two ids must be
# live at once or a rolling deploy 401s every internal call. Retiring an id is a
# DELIBERATE SECOND DEPLOY.
AI_HMAC_ACTIVE_KEY_ID=k1
# secrets — one file per KEY ID, never per rotation role:
#   AI_HMAC_KEY_K1_FILE=/run/secrets/hmac_key_k1
#   AI_HMAC_KEY_K2_FILE=/run/secrets/hmac_key_k2
AI_HMAC_KEY_K1=
AI_HMAC_KEY_K2=
# The reverse direction — FastAPI's job callbacks INTO Laravel — uses its own key ids, so
# a compromised outbound key cannot forge a callback.
#   AI_CALLBACK_HMAC_KEY_C1_FILE=/run/secrets/callback_hmac_key_c1
#   AI_CALLBACK_HMAC_KEY_C2_FILE=/run/secrets/callback_hmac_key_c2
AI_CALLBACK_HMAC_KEY_C1=
AI_CALLBACK_HMAC_KEY_C2=
AI_CALLBACK_ACCEPTED_PREFIXES=KB1

# -----------------------------------------------------------------------------
# Envelope encryption — the key-encrypting key (config/kb.php, kb-security-baseline §18.2).
#
# A per-credential data key encrypts each provider secret; the DEK is wrapped by this KEK and
# only the wrapped form is stored, next to `key_version`. NOT APP_KEY: that one covers sessions
# and cookies and rotates for different reasons, and sharing one key would make "log everyone
# out" and "re-wrap every tenant's provider credential" the same operation.
#
#   KB_KEK_PATH=/run/secrets/kek
#
# Leave empty in local development until the credential surface exists. KB_KEK_VERSION is an
# integer LABEL naming which KEK wrapped a row — not key material, and safe in an env var.
# -----------------------------------------------------------------------------
KB_KEK=
KB_KEK_VERSION=1

# Laravel never queries Qdrant. This is here because ParallelTesting token-scopes the
# collection name and because deletion verification needs both runtimes to name the same one.
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=kb_chunks

# -----------------------------------------------------------------------------
# Object storage — SeaweedFS behind its S3 gateway. ONE bucket; tenancy is the key prefix.
# -----------------------------------------------------------------------------
FILESYSTEM_DISK=s3
# The access key ID is an identifier and is safe in a config dump; the secret is not.
AWS_ACCESS_KEY_ID=
# secret — AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_key in Compose.
AWS_SECRET_ACCESS_KEY=
# SeaweedFS ignores the region but SigV4 signs it: it must be the IDENTICAL string on the
# boto3 side in services/ai-service.
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=kb-objects
# Direct on the internal network, never through Traefik: SeaweedFS mistakes HTTP chunked
# transfer framing for Content-Encoding: aws-chunked and stores the chunk-size lines AS
# FILE CONTENT — silent corruption, no error.
AWS_ENDPOINT=http://seaweedfs-s3:8333
# TRUE, non-negotiable. Virtual-host addressing is the SDK default and needs wildcard DNS
# for `kb.seaweedfs-s3`, which a Compose network does not have.
AWS_USE_PATH_STYLE_ENDPOINT=true

# -----------------------------------------------------------------------------
# OpenTelemetry. Traces only; logs go to stdout as JSON and are collected by the
# Collector's `file_log` receiver, so the app never blocks on the log pipeline.
# -----------------------------------------------------------------------------
# The PECL extension must be present in the image: `php -m | grep opentelemetry`. Missing,
# it emits an E_USER_WARNING nobody reads and instruments nothing.
OTEL_PHP_AUTOLOAD_ENABLED=true
# One of exactly four values the `service` label is bounded to. Queue workers are core-api too.
OTEL_SERVICE_NAME=core-api
# deployment.environment.NAME — not the long-dead deployment.environment.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.version=dev
# Same host, private network. NEVER a remote endpoint: PHP has no background thread, so the
# batch processor flushes inline at request shutdown and a dead Collector at the 10 s
# default timeout adds 10 s to every page.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# http/protobuf avoids ext-grpc in PHP entirely.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_TIMEOUT=3000
# One service on B3 splits every trace silently — a failed extraction is not an error in
# any SDK, it is a new root span.
OTEL_PROPAGATORS=tracecontext,baggage
# Head sampling is 100% everywhere; the Collector tail-samples. A head sampler drops the
# one request someone is investigating, irreversibly.
OTEL_TRACES_SAMPLER=parentbased_always_on
# `with_sampled_trace`, NOT the spec's `trace_based`. Same behaviour, older spelling: only a
# measurement taken inside a sampled span becomes an exemplar. open-telemetry/sdk 1.15.0
# (composer.lock) predates the rename — KnownValues.php:171 accepts exactly
# `with_sampled_trace | all | none`, and MeterProviderFactory.php:64-77 falls through to
# `default:` for anything else. Measured in knowledgebot/core-api:dev with `trace_based`:
#   [warning] Unknown exemplar filter: trace_based in .../Metrics/MeterProviderFactory.php(74)
#   filter = OpenTelemetry\SDK\Metrics\Exemplar\ExemplarFilter\NoneExemplarFilter
# So the wrong value did not merely warn — it selected NoneExemplarFilter and turned exemplars
# OFF for the whole control plane, which is the exact opposite of what this line buys
# (infrastructure/observability/grafana/.../prometheus.yml's exemplarTraceIdDestinations depends
# on it). This is the general shape and it is why a telemetry typo is expensive: an SDK that
# RECOGNISES a variable and REJECTS its value degrades to the safe default, and the safe default
# for an exemplar filter is `none` — so the mistake removes the surface you would have used to
# notice it. ai-service keeps `trace_based`; the Python SDK implements the current spelling.
# This is the ONE OpenTelemetry value that deliberately differs between the two runtimes.
OTEL_METRICS_EXEMPLAR_FILTER=with_sampled_trace
OTEL_LOGS_EXPORTER=none

# -----------------------------------------------------------------------------
# Horizon. /horizon gets no Traefik router label and never joins the `edge` network.
# -----------------------------------------------------------------------------
HORIZON_PATH=horizon
HORIZON_PREFIX=horizon:
