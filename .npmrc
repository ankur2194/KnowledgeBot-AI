# One lockfile per workspace, not one at the root. security-scanning-toolchain's DoD scans
# four pnpm-lock.yaml files with `osv-scanner --lockfile` (apps/web, apps/widget, apps/mobile,
# packages/contracts); a single shared lockfile collapses them into one scan target and one
# cache key. Orthogonal to `pnpm --filter`, which github-actions-pipeline requires — filtering
# selects workspaces, this decides where the resolution is written.
# CONSEQUENCE: the ROOT manifest must declare zero dependencies and zero devDependencies, or a
# fifth lockfile appears at the root. packages/design-tokens is dependency-free for the same reason.
shared-workspace-lockfile=false

# Exact versions on every install. A caret in a pinned stack is how tailwind-merge and tailwindcss
# drift apart between two installs of the "same" tree (tailwind-shadcn gotcha 5).
save-exact=true

# Refuse to install on the wrong Node/pnpm instead of failing later inside a build with an error
# that never mentions the engine. `engines` in the root package.json pins Node 22 LTS / pnpm 10.
engine-strict=true

# Peer dependencies are declared, never conjured. Auto-install hides a missing peer until the
# resolver picks a different major — the exact failure mode behind "@tanstack/react-store must be
# a DECLARED dependency of apps/web" (tanstack-query-table DoD).
auto-install-peers=false
