{
    "class": "App\\Http\\Requests\\UpdateProviderConnectionRequest",
    "rules": {
        "label": [
            "bail",
            "required_without:status",
            "string",
            "min:1",
            "max:120"
        ],
        "status": [
            "bail",
            "required_without:label",
            "string",
            "in:\"active\",\"invalid\",\"revoked\""
        ]
    }
}
