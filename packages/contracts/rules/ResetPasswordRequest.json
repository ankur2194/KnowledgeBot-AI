{
    "class": "App\\Http\\Requests\\ResetPasswordRequest",
    "rules": {
        "email": [
            "bail",
            "required",
            "string",
            "email:rfc,strict",
            "max:254"
        ],
        "password": [
            "bail",
            "required",
            "string",
            "min:12",
            "max:255",
            "confirmed",
            "regex:/\\p{Ll}/u",
            "regex:/\\p{Lu}/u",
            "regex:/\\d/u"
        ],
        "password_confirmation": [
            "bail",
            "required",
            "string"
        ],
        "token": [
            "bail",
            "required",
            "string",
            "max:255"
        ]
    }
}
