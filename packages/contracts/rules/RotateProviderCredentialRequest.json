{
    "class": "App\\Http\\Requests\\RotateProviderCredentialRequest",
    "rules": {
        "credential": [
            "bail",
            "required",
            "string",
            "not_regex:/^\\x{2026}/u",
            "min:8",
            "max:512"
        ],
        "current_password": [
            "bail",
            "required",
            "string",
            "current_password:web"
        ]
    }
}
