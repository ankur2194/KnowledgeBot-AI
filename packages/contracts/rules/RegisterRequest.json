{
    "class": "App\\Http\\Requests\\RegisterRequest",
    "rules": {
        "name": [
            "bail",
            "required",
            "string",
            "min:1",
            "max:120"
        ],
        "password": [
            "bail",
            "required",
            "string",
            "min:12",
            "max:255",
            "confirmed",
            "regex:/\\p{Ll}/u",
            "regex:/\\p{Lu}/u",
            "regex:/\\d/u"
        ],
        "password_confirmation": [
            "bail",
            "required",
            "string"
        ],
        "token": [
            "bail",
            "required",
            "string",
            "size:64"
        ]
    }
}
