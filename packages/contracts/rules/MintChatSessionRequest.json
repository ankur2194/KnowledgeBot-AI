{
    "class": "App\\Http\\Requests\\MintChatSessionRequest",
    "rules": {
        "bot_id": [
            "bail",
            "required",
            "string",
            "max:64",
            "regex:/^[A-Za-z0-9_-]{1,64}$/"
        ],
        "user_token": [
            "sometimes",
            "nullable",
            "string",
            "max:4096"
        ]
    }
}
