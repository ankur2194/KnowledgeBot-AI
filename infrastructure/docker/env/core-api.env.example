# infrastructure/docker/env/core-api.env.example -> copy to core-api.env
#
# CONTAINER ENVIRONMENT for the six Laravel services, delivered via `env_file:`.
# This is NOT the interpolation file. ${VAR} inside a compose file cannot see anything here —
# that is ../.env. The two directories are separate on purpose.
#
# NO SECRET VALUE BELONGS IN THIS FILE. The KEK, all four HMAC signing keys, the database password,
# the Valkey ACL password and the S3 secret arrive as Compose secrets at /run/secrets/<name>; the
# *_FILE / *_PATH variables below tell the application where to read them. A secret in an env var
# shows up in `docker inspect`, `docker compose config`, /proc/<pid>/environ and every crash report.

APP_NAME=KnowledgeBot
APP_ENV=production
APP_DEBUG=false
APP_URL=https://api.knowledgebot.example
APP_TIMEZONE=UTC

# ------------------------------------------------------------------------------------------------
# Credential paths (never the values)
# ------------------------------------------------------------------------------------------------
# Two suffixes, one rule, and the difference is not cosmetic:
#   *_FILE  the application resolves the file and populates the BASE variable of the same name
#           (DB_PASSWORD_FILE -> DB_PASSWORD). That base variable is what config/*.php reads.
#   *_PATH  the application reads a path and opens it itself; there is no base variable.
KB_KEK_PATH=/run/secrets/kek

# APP_KEY — Laravel's own application key, and NOT an env value here for the usual reason plus a
# sharper one. It is the AES-256-CBC key behind every `encrypted:` cast (the wrapped provider DEKs
# live in one), behind session and cookie payloads, and behind the audit `key_fingerprint` HMAC.
# `make prod-config` runs `docker compose config` as a documented pre-deploy step, which renders
# every environment value IN FULL — so `APP_KEY=base64:…` on this line is the key in a terminal
# scrollback and in whatever CI log captured it.
#
# The file's contents must be exactly `base64:` + base64(32 random bytes). A plain random string is
# accepted by config() and then throws "unsupported cipher or incorrect key length" at the FIRST
# decrypt — which surfaces to a user as a login loop, not as a configuration error.
#
# ROTATION IS ONE-WAY AND UNFORGIVING. Regenerating APP_KEY without first appending the outgoing
# value to APP_PREVIOUS_KEYS makes every encrypted column, session and cookie permanently
# undecryptable, including the stored provider credentials, which exist nowhere else. Restoring the
# database does not help; only the old key does.
APP_KEY_FILE=/run/secrets/app_key

# The retired keys, comma-separated, feeding config('app.previous_keys'). Laravel tries each in turn
# when the current key fails to decrypt, so the rotation window has both readable at once — same
# material, same custody, same secrets/ directory.
#
# THE FILE IS EMPTY on an unrotated deployment and that is correct: empty means "no previous keys".
# `APP_PREVIOUS_KEYS=` as an env value would mean the same, but writing a single comma or a stray
# newline into the file would hand Laravel one EMPTY key to try on every decrypt failure.
# scripts/ops/preflight.sh exempts this one name from its empty-secret failure.
APP_PREVIOUS_KEYS_FILE=/run/secrets/app_previous_keys

# ------------------------------------------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=knowledgebot
DB_USERNAME=knowledgebot
DB_PASSWORD_FILE=/run/secrets/postgres_password

# ------------------------------------------------------------------------------------------------
# Valkey — TWO INSTANCES, never two logical databases.
# maxmemory-policy, save and appendonly are SERVER settings, so `SELECT n` cannot separate a queue
# that must never be evicted from a cache that must be.
# ------------------------------------------------------------------------------------------------
REDIS_CLIENT=phpredis          # Laravel's documented default and recommendation; a worker runs an
                               # EVAL per poll forever, and the C extension is the right side of it.
                               # options.serializer and options.compression stay UNSET — the docs
                               # state plainly that the redis QUEUE driver does not support them.

# valkey-core: noeviction + AOF everysec. Queues, broker, locks, idempotency, breakers, sessions —
# and Laravel's DEFAULT cache store, which is not negotiable: Cache::lock(), WithoutOverlapping,
# RateLimiter and both scheduler mutexes resolve through the default store and every one of them
# fails OPEN when its key disappears. An evicted lock key reads as "lock is free", with no error on
# either side.
REDIS_HOST=valkey-core
REDIS_PORT=6379
REDIS_DB=0                     # 0 Laravel queues + default cache · 1 Celery broker · 2 coordination · 3 Horizon
REDIS_COORDINATION_DB=2
REDIS_HORIZON_DB=3

# AUTHENTICATION. `user default off` is set in valkey/users.acl on BOTH instances, so this is not
# hardening on top of a working connection — without it Laravel connects as `default`, which is
# disabled, and the first queue push fails with NOAUTH. That failure is loud and immediate, which
# is the point: the alternative posture (a shared `requirepass`) is one credential for four
# workloads that can be scoped to nothing and rotated for nobody.
#
# The username is a value; the password is a FILE. A password in an env var is visible in
# `docker inspect`, in `docker compose config`, in /proc/<pid>/environ and in every crash report,
# and Compose secrets exist precisely so it does not have to be.
REDIS_USERNAME=kb-core
REDIS_PASSWORD_FILE=/run/secrets/valkey_kb_core_password

CACHE_STORE=valkey             # the store NAME in config/cache.php, not a driver name — the stores
                               # there are `valkey`, `ephemeral`, `array`. CACHE_STORE=redis throws
                               # "Cache store [redis] is not defined" at the first Cache:: call.
                               # -> valkey-core. Pointing this at valkey-cache makes every nightly
                               # sweep double-run and every WithoutOverlapping job double-execute.
# ------------------------------------------------------------------------------------------------
# CACHE_PREFIX IS PART OF THE VALKEY ACL, NOT COSMETICS. PINNED HERE ON PURPOSE.
# ------------------------------------------------------------------------------------------------
# `valkey/users.acl` grants kb-core `~*_cache_*` (among others) and nothing wildcard. Every key the
# default cache store writes — including EVERY `Cache::lock()`, and therefore the atomic lock
# `php artisan migrate --isolated` takes — is `config('cache.prefix') . $name`. With an empty prefix
# those keys are bare names like `kb-probe`, they match NO pattern in the grant, and Valkey answers
#     NOPERM No permissions to access a key
# MEASURED: `migrate --isolated` exited 1 with exactly that, so the one-shot every other service
# gates on failed and the stack stopped — for a reason that mentions neither the cache nor the ACL.
#
# `config/cache.php:55` computes a sensible default, `Str::slug(APP_NAME,'_').'_cache_'`, but a
# default only applies when the variable is ABSENT. `services/core-api/.env.example:156` ships
# `CACHE_PREFIX=` — present and EMPTY — so the default never fires. That file reaches the container
# in DEVELOPMENT ONLY, through the `../../services/core-api:/app` bind mount in
# compose.override.yaml: Laravel's Dotenv load is immutable, so it fills in every variable the
# CONTAINER environment does not already set. Production has no bind mount and no app `.env`, so
# dev and prod disagreed about the cache keyspace and it was dev that was broken — the hardest
# direction to notice.
#
# Setting it HERE fixes both: `env_file:` is container environment, which Dotenv will not override.
# The value must keep the `_cache_` infix or the ACL pattern stops matching; if you change it,
# change `~*_cache_*` in valkey/users.acl in the same commit.
CACHE_PREFIX=knowledgebot_cache_

QUEUE_CONNECTION=valkey
SESSION_DRIVER=redis           # a DRIVER name here (session.php), unlike CACHE_STORE above.
SESSION_STORE=valkey           # ...and the store it writes through: valkey-core, never the LRU one.

# valkey-cache: allkeys-lru, no RDB, no AOF, no volume. Reachable ONLY as an explicitly named
# store — Cache::store('ephemeral') — for cfg: and quota: read-through and nothing else.
# Same ACL USER as above, deliberately: an ACL user is a service identity, not a per-server
# credential, and users.acl is mounted into both instances. kb-core's grant is what separates the
# two, not the password.
REDIS_CACHE_HOST=valkey-cache
REDIS_CACHE_PORT=6379
REDIS_CACHE_DB=0
REDIS_CACHE_USERNAME=kb-core
REDIS_CACHE_PASSWORD_FILE=/run/secrets/valkey_kb_core_password

# Horizon lives on its own logical DB via the reserved `horizon` connection name.
HORIZON_PREFIX=horizon:

# ------------------------------------------------------------------------------------------------
# Object storage — direct, never through a reverse proxy.
# SeaweedFS mistakes HTTP `Transfer-Encoding: chunked` framing for `Content-Encoding: aws-chunked`
# and stores the chunk-size lines as file content: silent corruption with no error.
# ------------------------------------------------------------------------------------------------
AWS_ENDPOINT=http://seaweedfs-s3:8333
AWS_BUCKET=kb                  # ONE bucket, forever. Tenancy is the key prefix, enforced in code.
AWS_DEFAULT_REGION=us-east-1   # SeaweedFS ignores it, SigV4 signs it; must be the identical string
                               # in the Python client or every signature fails.
AWS_USE_PATH_STYLE_ENDPOINT=true   # virtual-host addressing needs wildcard DNS a Compose network
                                   # does not have — the symptom is NXDOMAIN for kb.seaweedfs-s3
AWS_ACCESS_KEY_ID=kb-app
AWS_SECRET_ACCESS_KEY_FILE=/run/secrets/s3_secret_key

# ------------------------------------------------------------------------------------------------
# The internal seam. Clients never reach FastAPI; Laravel is the only caller.
# ------------------------------------------------------------------------------------------------
# Names match config/services.php exactly — every one of these is an `env(...)` key there.
AI_SERVICE_URL=http://ai-api:8000

# OUTBOUND signing, Laravel -> FastAPI. Key ids, never rotation roles: the id travels on the wire
# inside X-KB-Signature, two ids are live at once during a rotation, and the verifier picks the
# secret by id. A file named `current` cannot answer which id it holds.
#
# ROTATION, in full: write secrets/hmac_key_k3, declare + mount it, deploy (verifiers now accept
# k1..k3, signers still emit k1) — then, as a SECOND deploy, set AI_HMAC_ACTIVE_KEY_ID=k3. Retiring
# k1 is a THIRD deploy. Nothing is ever renamed, and no window exists where a signer emits an id
# some verifier has never seen.
AI_HMAC_ACTIVE_KEY_ID=k1
AI_HMAC_KEY_K1_FILE=/run/secrets/hmac_key_k1
AI_HMAC_KEY_K2_FILE=/run/secrets/hmac_key_k2

# INBOUND verification, FastAPI -> Laravel callbacks (POST /internal/v1/callbacks/*). A SEPARATE
# key set, and that separation is the security property: with one shared set, anything holding the
# outbound key could forge a callback — and a forged callback flips job state, publishes a source
# version, or marks a deletion verified. Every test still passes if you merge them.
AI_CALLBACK_HMAC_KEY_C1_FILE=/run/secrets/callback_hmac_key_c1
AI_CALLBACK_HMAC_KEY_C2_FILE=/run/secrets/callback_hmac_key_c2
# Accepted canonical-string prefixes, comma-separated. CONFIGURATION, not a constant: bumping KB1
# to KB2 is two deploys, and during the first the verifier must accept both while the signer emits
# only one. `KB1,KB2` is what that window looks like.
AI_CALLBACK_ACCEPTED_PREFIXES=KB1

# ------------------------------------------------------------------------------------------------
# OpenTelemetry — identical keys in all four runtimes.
# ------------------------------------------------------------------------------------------------
OTEL_PHP_AUTOLOAD_ENABLED=true
OTEL_SERVICE_NAME=core-api     # queue workers are `core-api` too; `service` is bounded to 4 values
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf   # avoids ext-grpc entirely
OTEL_EXPORTER_OTLP_TIMEOUT=3000             # NOT the 10 s default. PHP has no background threads,
                                            # so the batch processor flushes inline at request
                                            # shutdown — a dead Collector adds its full timeout to
                                            # every page. Never point PHP-FPM at a remote endpoint.
OTEL_PROPAGATORS=tracecontext,baggage       # one service on B3 splits every trace, silently
OTEL_TRACES_SAMPLER=parentbased_always_on   # head 100%; the Collector tail-samples
# `with_sampled_trace`, NOT the spec's `trace_based`, and this is the ONE OpenTelemetry value in
# this file that deliberately differs from ai-service.env. It is the same behaviour under a
# different spelling: only measurements taken inside a sampled span become exemplars.
#
# open-telemetry/sdk 1.15.0 (composer.lock) predates the spec's rename. KnownValues.php:171 accepts
# exactly `with_sampled_trace | all | none`, and MeterProviderFactory.php:64-77 falls through to
# `default:` for anything else. Measured in knowledgebot/core-api:dev on 2026-08-11 with
# `trace_based`:
#   [warning] Unknown exemplar filter: trace_based in …/Metrics/MeterProviderFactory.php(74)
#   filter = OpenTelemetry\SDK\Metrics\Exemplar\ExemplarFilter\NoneExemplarFilter
# So the old value did not merely print a warning on every boot — it selected NoneExemplarFilter
# and turned exemplars OFF for the entire control plane, which is the exact opposite of what the
# line is here to buy (Grafana's prometheus.yml exemplarTraceIdDestinations depends on it).
# `with_sampled_trace` boots silently and yields WithSampledTraceExemplarFilter; both verified.
# Revisit when the PHP SDK adopts the spec spelling — a value the SDK does not know fails SOFT.
OTEL_METRICS_EXEMPLAR_FILTER=with_sampled_trace
OTEL_LOGS_EXPORTER=none                     # stdout JSON, collected by the Collector's file_log
                                            # receiver — the app never blocks on the log pipeline

# DELIBERATELY ABSENT and must stay absent in EVERY environment, including local:
#   OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT
# It gates gen_ai.input.messages, gen_ai.output.messages, gen_ai.system_instructions,
# gen_ai.retrieval.query.text and gen_ai.retrieval.documents — the user's question and the
# retrieved tenant chunks. Setting it ships every conversation into Tempo, which has no per-tenant
# access control. The bootstrap refuses to start if it is set to anything at all.

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
