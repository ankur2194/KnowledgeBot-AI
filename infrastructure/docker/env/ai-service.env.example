# infrastructure/docker/env/ai-service.env.example -> copy to ai-service.env
#
# CONTAINER ENVIRONMENT for ai-api and every ai-worker-*, delivered via `env_file:`.
# Not the interpolation file — that is ../.env.
# No secret VALUE here; the *_PATH variables point at /run/secrets/<name>.

# KB_ENV -> KB_ENVIRONMENT. THE FIELD IS `environment`, AND THE OLD SPELLING WAS DISCARDED.
# Measured in the running stack before this change: `KB_ENV=production` was present in the
# container's environment and `Settings().environment` read `local`. pydantic-settings resolves a
# field by looking up ITS OWN name and never enumerates the environment, so a name it does not
# recognise is a name it never sees — `extra="forbid"` cannot catch it (config.py:5-16). Every
# ai-api and ai-worker-* container has therefore been running as `local` while its own template
# said `production`, and the only visible consequence today is that the startup log line at
# app/main.py:64 and anything correlating on it NAME THE WRONG ENVIRONMENT. That is a forensics
# defect now and a safety-rail defect the moment anything gates on it, which is the argument for
# fixing it before something does.
KB_ENVIRONMENT=production

# WAS ABSENT FROM THIS TEMPLATE ENTIRELY, WHILE THE CODE READS IT AND CALLS ITSELF THE ONLY SOURCE
# OF TRUTH. `Settings.log_level` (config.py) maps to KB_LOG_LEVEL, and
# app/observability/logging.py::_resolve_level says in its own docstring that this value
# "DELIBERATELY OUTRANKS `celery --loglevel`" — Celery's flag is accepted and ignored so that one
# knob configures all five Celery containers plus ai-api. A knob that is documented nowhere in the
# deployment is a knob nobody turns: the effective level came from the field default with no
# indication that it was settable. services/ai-service/.env.example already carried it, so the
# CONTAINER template was the only place it was missing.
#
# Literal["DEBUG", "INFO", "WARNING", "ERROR"] — a value outside the four is a pydantic
# ValidationError at startup, not a silent fall-back to INFO.
KB_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------------------------
# Credential paths.
# NOTE WHAT IS ABSENT: there is no KEK path. FastAPI never holds the key-encryption key (ADR-011).
# Laravel decrypts per request and sends the plaintext provider key as a top-level
# `provider_credential` SecretStr field on the internal request body — excluded from the
# configuration-snapshot hash so a rotation does not move configuration_version, and on the
# never-forward list: no SSE frame, no error envelope, no span attribute, no log field, no audit
# detail, no persisted snapshot.
# ------------------------------------------------------------------------------------------------
#
# THE SIGNING KEYS ARE ADDRESSED BY DIRECTORY, NOT BY PATH — one variable for four keys, and that
# is deliberate. app/core/keys.py LISTS this directory once at startup and takes each key id from
# the filename after `hmac_key_` / `callback_hmac_key_`:
#
#     /run/secrets/hmac_key_k1            -> request  ring, id "k1"   (Laravel -> FastAPI)
#     /run/secrets/hmac_key_k2            -> request  ring, id "k2"
#     /run/secrets/callback_hmac_key_c1   -> callback ring, id "c1"   (FastAPI -> Laravel)
#     /run/secrets/callback_hmac_key_c2   -> callback ring, id "c2"
#
# It must NOT be a per-key path variable, and the reason is a vulnerability rather than a
# preference: `key_id` arrives ON THE WIRE, attacker-chosen on every unauthenticated request.
# Building `hmac_key_dir / f"hmac_key_{key_id}"` hands the attacker a file selector — aim it at any
# zero-length file the process can read and the HMAC key becomes b"", after which they can compute
# a valid signature over any canonical string, for any organization, and every downstream tenant
# filter agrees with the result. Loading eagerly from a listing makes a lookup a mapping access
# against ids that were already there, and costs one directory listing per boot.
#
# THIS IS ALSO WHY THE FILES ARE NAMED BY KEY ID. Renaming one removes that id from the ring.
KB_HMAC_KEY_DIR=/run/secrets

# The ids this process SIGNS with. Verification accepts every id in the ring — that tolerance is
# what makes a rotation survivable — but signing needs exactly one, and startup fails if it has no
# material. Two variables, not one: signing a callback with `k1` gets rejected by a verifier
# holding only c1/c2, and the symptom is a silent 401 on every async job callback, i.e. jobs that
# never report terminal state while every health check stays green.
KB_HMAC_ACTIVE_KEY_ID=k1
KB_CALLBACK_ACTIVE_KEY_ID=c1

# ------------------------------------------------------------------------------------------------
# PostgreSQL — FastAPI writes exactly four derived tables and reads nothing else (ADR-012):
# chunks, document_elements, retrieval_traces, evaluation_results. Laravel owns every migration and
# every other table, including the source_items.current_version_id flip. A CI allow-list gate fails
# on the fifth table name.
# ------------------------------------------------------------------------------------------------
# THE ROLE SPLIT (D21). All six ai-service containers connect as kb_app: NOSUPERUSER, owns nothing,
# USAGE and not CREATE on schema public, and no UPDATE/DELETE/TRUNCATE on audit_logs or any of its
# partitions. There is no override anywhere in this plane — the data plane issues no DDL and owns no
# migration (ADR-012), so no ai-service container has any reason to hold the owner credential, and
# none of them mounts postgres_migrate_password.
#
# WHY NOT `knowledgebot`: `POSTGRES_USER` makes that role a SUPERUSER, and a superuser bypasses every
# ACL check — including the four-table write allow-list's database-side counterpart. Measured on
# 18.4: `UPDATE audit_logs SET operation='tampered'` returned `UPDATE 1` as knowledgebot and
# `permission denied` as kb_app.
#
# STILL OPEN, AND WORTH KNOWING: the four-table write restriction is enforced ONLY by
# `ALLOWED_TABLES` in app/db/writes.py and by the CI gate over it. kb_app holds
# SELECT/INSERT/UPDATE/DELETE on EVERY table, so nothing at the database level stops this plane
# writing `organizations`. A third role granted only the four derived tables would make that
# structural — it is designed and not taken, because two of the four (chunks, document_elements)
# have no migration yet (#79), so there is no relation to grant on. Recorded in the report.
KB_PG_HOST=postgres
KB_PG_PORT=5432
KB_PG_DATABASE=knowledgebot
KB_PG_USER=kb_app
KB_PG_PASSWORD_PATH=/run/secrets/postgres_app_password

# ------------------------------------------------------------------------------------------------
# Valkey. Broker on core db 1. The URL scheme is `redis://` and never `valkey://` — kombu has no
# valkey transport and raises `No such transport`. Valkey works as a RESP drop-in behind the Redis
# transport; every command kombu issues predates the fork point.
# ------------------------------------------------------------------------------------------------
# DB 1, AND THIS TEMPLATE IS THE CORRECT SIDE OF A DISAGREEMENT WITH THE CODE.
# `valkey-keyspaces` allocates valkey-core's logical DBs as: 0 Laravel queues + Laravel's DEFAULT
# cache store · 1 Celery broker · 2 coordination · 3 Horizon. valkey/users.acl already encodes
# the same 1 for the pidbox channel grants (`&/1.celery.pidbox &/1.celeryev/worker.*`).
#
# `services/ai-service/app/core/config.py` declares `broker_url: str = "redis://valkey-core:6379/0"`
# — DB 0, which is Laravel's queues and its default cache store. Any ai-service process that does
# not load this file (a pytest run, an ad-hoc `celery -A app.worker inspect`, a shell in the image)
# publishes and consumes in Laravel's keyspace: kb-ai's ACL has no ~queues:* grant, so the first
# symptom is NOPERM rather than a collision — but the two share `_kombu.binding.*` and `unacked`,
# which kb-ai IS granted, and a FLUSHDB or an eviction there loses Laravel jobs. Containers are
# unaffected because `env_file:` supplies this line. The fix is one character in config.py and
# belongs to services/ai-service; do NOT "reconcile" by changing this line to /0.
KB_BROKER_URL=redis://valkey-core:6379/1
KB_COORDINATION_URL=redis://valkey-core:6379/2   # locks, fences, nonces, idempotency, breakers
KB_CACHE_URL=redis://valkey-cache:6379/0         # answer + retrieval caches — the ONLY tenant text
                                                 # in Valkey, on the instance that never touches disk

# AUTHENTICATION. `user default off` is set in valkey/users.acl on BOTH instances, so a URL with no
# credentials does not connect at all — kombu retries a NOAUTH forever and no queue is ever
# consumed. The credentials are NOT in the URLs above on purpose: a URL is an env var, and an env
# var is in `docker inspect`, `docker compose config` and /proc/<pid>/environ. Username as a value,
# password as a mounted file, composed into the connection at runtime.
#
# kb-ai's grant deliberately excludes ~queues:*, ~horizon:* and ~*_cache_*: the data plane must not
# be able to read — still less delete — Laravel's queues.
KB_VALKEY_USERNAME=kb-ai
KB_VALKEY_PASSWORD_PATH=/run/secrets/valkey_kb_ai_password

# THERE IS NO RESULT BACKEND, IN ANY ENVIRONMENT — AND THERE IS NO VARIABLE FOR ONE EITHER.
# A backend writes a tombstone per task for result_expires whether or not anything reads it, and
# .get() inside a task deadlocks the pool. Job status is background_jobs in PostgreSQL plus the
# §17.5 Laravel callbacks; `celery-workers` makes "result_backend is unset in every environment"
# a definition-of-done item.
#
# `KB_RESULT_BACKEND=` (empty) used to sit here, and an empty knob is an INVITATION: the next
# person debugging a stuck job fills it in, gets what looks like a helpful feature, and ships the
# unbounded Valkey growth and the pool deadlock the rule exists to prevent. It is deleted rather
# than blanked, and no field is requested for it. Under config.py's check_environment() a
# template variable with no field is now a startup failure, so re-adding this line breaks boot —
# which is the correct outcome and cheaper than the alternative.

# ------------------------------------------------------------------------------------------------
# Qdrant. Its REST API is UNAUTHENTICATED by default — which is the whole reason ai-worker-crawl is
# kept off the `data` network. Network isolation is the primary control here; the api key is the
# second latch and only exists if the server was started with one (see qdrant/config.yaml).
# ------------------------------------------------------------------------------------------------
KB_QDRANT_URL=http://qdrant:6333
# A PATH, NOT A VALUE — same treatment as the Postgres and Valkey credentials, and for the same
# reason: an env-var secret is visible to `docker inspect`, `docker compose config`, a crash dump
# and every child process. The field is currently `qdrant_api_key: SecretStr | None`, a value, so
# code and template disagree here; the fix is a `qdrant_api_key_path` field plus a reader at
# point of use, NOT changing this line back to a value.
KB_QDRANT_API_KEY_PATH=/run/secrets/qdrant_api_key

# ------------------------------------------------------------------------------------------------
# Object storage. Path-style + SigV4 + the same region string Laravel uses.
# request/response checksum "when_required" is deliberate: integrity is our own SHA-256 recorded in
# PostgreSQL, so the SDK's default per-request CRC32 buys nothing and costs a whole
# interop-breakage class against SeaweedFS.
# ------------------------------------------------------------------------------------------------
KB_S3_ENDPOINT=http://seaweedfs-s3:8333
KB_S3_BUCKET=kb

# KEEPS ITS VARIABLE AND EARNS A FIELD (`s3_region: str = "us-east-1"`). SeaweedFS ignores the
# region, but SigV4 SIGNS it, so the string must be byte-identical to Laravel's — which is why
# env/core-api.env.example:152 carries `AWS_DEFAULT_REGION=us-east-1  # ... must be the identical
# string`. A value two services must agree on is a deployment contract, not an implementation
# detail, and burying it as a default inside each codebase is how the two drift into a
# SignatureDoesNotMatch that reads like a credential problem.
KB_S3_REGION=us-east-1

# KB_S3_ADDRESSING_STYLE IS GONE, DELIBERATELY, AND MUST BE HARDCODED INSTEAD.
# There is exactly one value that works: virtual-host addressing resolves `kb.seaweedfs-s3`,
# which needs wildcard DNS a Compose network does not have, and fails with
# EndpointConnectionError / NXDOMAIN (`seaweedfs-s3` gotcha). A setting whose only correct value
# is one value is not configuration — it is a way to break the deployment that looks like a knob,
# and it is the kind of line someone "fixes" to `virtual` while chasing an unrelated error.
# Pin `s3={"addressing_style": "path"}` in the boto3 client config next to SigV4 and the
# `when_required` checksum setting, where the three that must travel together are visible at once.
#
# RE-ADDING THIS LINE NOW BREAKS BOOT, AND THAT IS THE DESIGNED OUTCOME RATHER THAN A SIDE EFFECT.
# config.py's `KNOWN_UNMAPPED_VARIABLES` is EMPTY, so `check_environment()` raises RuntimeError on
# any KB_* variable in the process environment that matches no `Settings` field and is not listed
# in `EXTERNALLY_READ_VARIABLES`. `KB_S3_ADDRESSING_STYLE=path` here would therefore stop ai-api
# and all five Celery containers from starting — not misconfigure them. Written down because the
# argument above ("do not add a knob with one correct value") reads like style advice and this is
# not: the enforcement is live.
#
# THE OTHER HALF OF THIS PAIR IS ALREADY PINNED AND MUST STAY PINNED. Laravel has no such
# enforcement, so its addressing style IS an environment variable and is set explicitly:
# env/core-api.env `AWS_USE_PATH_STYLE_ENDPOINT=true` (and `config/filesystems.php` defaults the
# same way). The two services must agree — boto3 and flysystem-s3 do not share a default, and a
# disagreement fails per BUCKET NAME rather than at startup, which is why it reads as a 404 on
# some objects and not others instead of as a configuration error.

# KEEPS ITS SPELLING; THE FIELD SHOULD MOVE TO `s3_access_key_id`, AND THAT DIRECTION IS NOT
# arbitrary. The field is `s3_access_key`, so one of the two names has to move, and the template is
# the one that should not:
#
#   * `KB_S3_ACCESS_KEY_ID` is what the thing is called everywhere else it appears — AWS's own
#     `AWS_ACCESS_KEY_ID`, boto3's `aws_access_key_id`, SeaweedFS's identities file, and
#     env/core-api.env.example, which spells it `AWS_ACCESS_KEY_ID` for the SAME credential
#     (`kb-app`). Renaming the template to `KB_S3_ACCESS_KEY` would make this the only place in
#     the deployment that calls it something else.
#   * `s3_access_key` reads as a sibling of `s3_secret_key`, which is the confusion worth removing:
#     one is a public identifier that belongs in a log line, the other is a secret that belongs in
#     a mounted file and never in an environment variable. The `_ID` / `_PATH` asymmetry between
#     this line and the one below is what tells a reader which half is which at a glance, and
#     matching names would erase exactly that signal.
KB_S3_ACCESS_KEY_ID=kb-app

# A PATH, NOT A VALUE, AND THAT IS THE POINT. An environment-delivered secret is readable through
# `docker inspect`, `docker compose config`, a crash dump and every child process; a mounted file
# is not. The Postgres and Valkey credentials already work this way. The field is currently
# `s3_secret_key: SecretStr` — a value — so this template and the code still disagree; the
# reconciliation is the path-plus-reader one, in the code, not a retreat to an env var here.
KB_S3_SECRET_KEY_PATH=/run/secrets/s3_secret_key

# ------------------------------------------------------------------------------------------------
# Models. Mounted :ro in production; weights are baked or pre-populated, never fetched at runtime.
# Revisions are pinned by COMMIT SHA in services/ai-service/models.manifest.toml — "main" moves, so
# a scan of it proves nothing about what shipped, and the licence gate rejects it.
# ------------------------------------------------------------------------------------------------
HF_HOME=/models
HF_HUB_OFFLINE=1

# SET EXPLICITLY, EVEN THOUGH THE FIELD ALREADY DEFAULTS TO EXACTLY THIS. /models is now stated in
# FIVE places, and the value of writing it here is that the fifth is not a default anybody has to
# infer:
#
#   1. the `models:` volume mountpoint in all three compose files   (`models:/models`)
#   2. the Dockerfile's HF_HOME and its `docling-tools models download --output-dir /models`
#   3. app/ingestion/parsing/converter.py's ARTIFACTS_PATH           (was /opt/docling-artifacts)
#   4. Settings.model_cache_dir's default
#   5. this line
#
# ARTIFACTS_PATH was the one dissenter and has been moved to /models, so the set agrees today. That
# is exactly when to write the value down rather than after it drifts again: a default that happens
# to match is not agreement, it is four places and a coincidence, and it fails silently in the one
# direction that matters — weights land where nothing reads them, and with HF_HUB_OFFLINE=1 the
# symptom is a first-parse failure a long way from the cause. Naming it here makes the mountpoint a
# single stated value a test can assert every other copy against.
KB_MODEL_CACHE_DIR=/models
# NO KB_EMBEDDING_DEVICE / KB_RERANKER_DEVICE. Embeddings and reranking are provider API calls
# now, so there is no local model and no device to place it on. The old comment here claimed a
# CPU cross-encoder "misses the retrieval budget by an ORDER OF MAGNITUDE" — that argument died
# with the component it justified, and it is removed rather than left to mislead.
#
# KB_OCR_DEVICE is likewise absent, and deliberately: RapidOCR runs on `onnxruntime`, the CPU
# build. Accelerating OCR would mean swapping that distribution for `onnxruntime-gpu`, which is a
# dependency change, not an environment variable.

# ------------------------------------------------------------------------------------------------
# The internal seam, back toward Laravel.
# ------------------------------------------------------------------------------------------------
# KEEPS ITS VARIABLE AND EARNS A FIELD (`core_api_url: str`). This is not speculative: four async
# flows in kb-internal-api-contracts finish by calling BACK into Laravel — ingestion progress,
# crawl page results, deletion verification and evaluation metrics all return `202 {job_id}` and
# then deliver their real result over a signed callback. Every one needs a base URL, and there is
# nowhere else for it to come from. The callback direction is already half-configured here (the
# key id below), so dropping the URL would leave a credential for a destination that has no name.
KB_CORE_API_URL=http://laravel-api:8080
# The id this service signs callbacks with is KB_CALLBACK_ACTIVE_KEY_ID, set in the credential
# block above. There is no second "signing key id" variable here: one id per direction, named for
# the direction, and a third name would be a third place for the two to disagree.

# ------------------------------------------------------------------------------------------------
# OpenTelemetry
# ------------------------------------------------------------------------------------------------
# ai-api ONLY. The four ai-worker-* containers AND ai-beat override this to `ai-worker` with an
# `environment:` key in compose.yaml — see the block on ai-worker-ingestion for why the value is
# `ai-worker` rather than a per-queue name. This line used to say "workers override ... per
# container" as though that were already true; NO COMPOSE FILE OVERRODE IT, so all six
# ai-service processes reported `service=ai-api`. The claim and the override now agree.
# `service` is bounded to FOUR values by kb-observability-conventions' label allow-list:
# core-api | ai-api | ai-worker | web. Do not add a fifth here.
OTEL_SERVICE_NAME=ai-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=production
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf   # grpc's background threads plus prefork fork() deadlock
                                            # on the first export from a Celery child
OTEL_EXPORTER_OTLP_TIMEOUT=3000
OTEL_PROPAGATORS=tracecontext,baggage
OTEL_TRACES_SAMPLER=parentbased_always_on
# `trace_based` is the SPEC spelling and is what opentelemetry-sdk accepts and defaults to
# (sdk/metrics/_internal/__init__.py:493). Stated rather than left implicit so the intent survives
# a default change. THE CONTROL PLANE'S VALUE IS DIFFERENT ON PURPOSE: open-telemetry/sdk 1.15.0
# for PHP predates the rename and knows only `with_sampled_trace | all | none`, so core-api.env
# carries `with_sampled_trace` — same behaviour, and the reason is written out there. If you
# normalise the two spellings, normalise them to what each SDK understands, not to one string.
OTEL_METRICS_EXEMPLAR_FILTER=trace_based
OTEL_LOGS_EXPORTER=none

# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT is absent and must stay absent. The bootstrap
# raises at startup if it is set to anything — fail closed, because an operator who exports one
# conversation to Tempo has exported all of them.

# ------------------------------------------------------------------------------------------------
# Uvicorn
# ------------------------------------------------------------------------------------------------
# One process per container. WEB_CONCURRENCY silently sets --workers even with no such flag on the
# command line, which is why it is pinned here AND on the service in compose.yaml — an unset value
# is not "one", it is uvicorn's own default.
#
# THE ORIGINAL JUSTIFICATION IS GONE, AND ANYONE RE-TUNING THIS SHOULD KNOW THAT. This line used to
# read "each worker process loads its OWN copy of the embedder (~2.3 GB) and the reranker
# (~2.3 GB)", which made 1 the only affordable number. ADR-030 moved embedding and reranking to
# provider APIs, so `ai-api` now holds clients and pools, not weights, and ~4.6 GB per extra
# process is not the cost any more. The number is still 1 — one process per container keeps the
# concurrency story in Compose replicas where it can be reasoned about — but it is now a choice
# rather than a memory ceiling, and it should be re-argued on its merits rather than defended with
# a footprint that no longer exists.
WEB_CONCURRENCY=1
