# Expo's generated ambient types. Regenerated by `expo start`; committing it produces a conflict
# on every SDK bump for a file nobody wrote.
expo-env.d.ts

# expo-router's generated typed-route declarations (experiments.typedRoutes).
.expo/

# EAS Update code-signing material. The CERTIFICATE is meant to be committed once it exists (it is
# embedded in the binary and is the trust anchor); the PRIVATE KEY must never be, and must not live
# in ordinary CI either — a key here plus a compromised publish is remote code execution inside a
# process holding a bearer token.
certs/*.key
certs/private-key.pem

# The native projects are generated by `expo prebuild` from app.json + app.config.ts + plugins/.
# Already covered at the repo root; restated here so the reason travels with the package: commit
# them and the generated tree becomes the source of truth, the config plugin below stops being the
# thing that pins ATS, and every prebuild is a merge conflict.
/ios/
/android/
