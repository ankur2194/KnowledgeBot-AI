# apps/widget build-time environment.
#
# These are read by vite.config.ts and baked into BOTH bundles as `define` TEXT SUBSTITUTIONS —
# they are not runtime configuration and cannot be changed after the build. There is no
# `.env`-driven origin here on purpose: an origin the host page could influence is not an origin.
#
# TWO SPELLINGS, either of which satisfies the build:
#
#   1. The domain form — Compose's variables and Traefik's two hostnames. `<widget-domain>` is a
#      SEPARATE REGISTRABLE DOMAIN from `<domain>`, and vite.config.ts fails the build if they look
#      like the same one. That is not stylistic: the admin session cookie is scoped to the main
#      domain, so an API on the widget's eTLD+1 puts a widget iframe on a hostile customer page
#      same-site with a real admin credential.
DOMAIN=knowledgebot.example
WIDGET_DOMAIN=kb-widget.example

#   2. The full-origin form — what apps/widget/Dockerfile passes as build ARGs, and the only form
#      that can express the http:// loopback origins the Playwright harness uses. Wins when set.
# KB_WIDGET_ORIGIN=https://kb-widget.example
# KB_API_ORIGIN=https://api.knowledgebot.example

# Stamped into `__KB_VERSION__`, which appears only in the double-injection console warning so a
# customer can see which copy of the loader won. Falls back to the package version.
# KB_VERSION=dev

# Escape hatch for a multi-part public suffix (e.g. example.co.uk vs kbwidget.co.uk), where the
# build's "last two labels" heuristic cannot tell a legitimate split from a collapsed one. Set it
# only after confirming the real eTLD+1s differ.
# KB_ALLOW_SHARED_SUFFIX=1

# ------------------------------------------------------------------------------------------------
# Playwright harness origins. Defaults are loopback; point them at hosts-file names to exercise
# cookie / SameSite / CHIPS behaviour, which loopback cannot express (`__Host-` requires Secure).
# ------------------------------------------------------------------------------------------------
# KB_CUSTOMER_BASE_URL=http://localhost:4174
# KB_WIDGET_BASE_URL=http://127.0.0.1:4173
# KB_API_BASE_URL=http://127.0.0.1:4175
