{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],

    // Preact's automatic runtime, matching `oxc.jsx` in vite.config.ts. The two must agree: a
    // tsconfig saying `react-jsx` with the default importSource type-checks against React's JSX
    // namespace while the bundler emits Preact's, and the mismatch surfaces as a wall of prop
    // errors that look like a Preact bug.
    "jsx": "react-jsx",
    "jsxImportSource": "preact",

    // NO "@types/react", deliberately, and no React compatibility alias anywhere in this
    // workspace. With React's types absent, an accidental `import … from 'react'` fails at
    // type-check as well as at bundle time, which is the point: the compat layer suppresses
    // exactly the error that tells you a React dependency got in.
    //
    // "node" is here for vite.config.ts / the harness servers reading process.env; "vite/client"
    // supplies `import.meta.env` and the `?inline` module declarations.
    "types": ["node", "vite/client"],

    "noEmit": true,
    "allowJs": false
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["node_modules", "dist"]
}
