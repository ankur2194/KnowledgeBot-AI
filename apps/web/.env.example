# apps/web publishes EXACTLY ONE public variable. `NEXT_PUBLIC_` inlines a value at build time
# into every bundle that references it, with no type safety behind the prefix, so the allow-list in
# src/lib/env.ts fails the build on any other NEXT_PUBLIC_* key.
#
# There is no provider credential, no internal HMAC signing key and no FastAPI hostname in this
# app — not as a public variable and not as a server one. apps/web is on the `edge` network only
# (ADR-013) and talks to Laravel and nothing else.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8080

# Server-side only, read by instrumentation.ts. Must be one of the four values the `service` label
# is bounded to, and this app's is `web`. The other three name services this app cannot reach.
OTEL_SERVICE_NAME=web
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Playwright's baseURL. It must appear in Laravel's SANCTUM_STATEFUL_DOMAINS **with its port**, or
# Sanctum classifies the request third-party and the suite fails with 419 CSRF token mismatch —
# not 401, which sends everyone looking at the wrong handler.
KB_WEB_BASE_URL=http://localhost:3000
